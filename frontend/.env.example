# Arayuzun konusacagi API adresi.
#
# Bu deger verilmezse "http://localhost:8000/api" kullanilir; bu yalnizca
# gelistirme icin dogrudur. Telefondan veya baska bir bilgisayardan
# acildiginda "localhost" o cihazin kendisi anlamina geldigi icin uygulama
# sunucuya ulasamaz.
#
# Yayina alirken bu dosyayi ".env" adiyla kopyalayip adresi yazin:
VITE_API_BASE_URL=https://teklif.sirketiniz.com/api
