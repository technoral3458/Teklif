# Membran Kapak Yönetim Sistemi - ortam değişkenleri örneği
# Bu dosyayı .env olarak kopyalayıp doldurun.
ANTHROPIC_API_KEY=sk-ant-...
SECRET_KEY=degistirin-rastgele-bir-anahtar
# İsteğe bağlı: tarama için kullanılacak model
ANTHROPIC_MODEL=claude-sonnet-4-6
# Google ile giriş: OAuth istemci kimliği (….apps.googleusercontent.com). Boşsa Google düğmesi çıkmaz.
GOOGLE_CLIENT_ID=
