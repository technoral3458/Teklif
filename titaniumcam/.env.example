# TitaniumCam - ortam değişkenleri örneği
# Bu dosyayı .env olarak kopyalayıp doldurun.
SECRET_KEY=degistirin-rastgele-bir-anahtar
# Google ile giriş: OAuth istemci kimliği (….apps.googleusercontent.com). Boşsa Google düğmesi çıkmaz.
GOOGLE_CLIENT_ID=
# Acil lisans: özel anahtar klasörü (web kökü DIŞINDA, 0700). Deneme ortamı ayrı klasör kullanır.
ACIL_ANAHTAR_DIR=/etc/titaniumcam/acil_lisans
# Yerel GeoIP (DB-IP Lite). Dosya yoksa ülke/şehir boş kalır.
GEOIP_DB=/var/lib/GeoIP/dbip-city-lite.mmdb
# Bildirim e-postası (firma SMTP). 465 = SSL, 587 = STARTTLS
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
