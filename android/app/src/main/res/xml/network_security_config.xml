<?xml version="1.0" encoding="utf-8"?>
<!--
    Sirket ici sunucular bazen henuz HTTPS'e gecmemis olabiliyor; bu yuzden
    duz HTTP baglantisina izin veriliyor. Sitenizde HTTPS varsa bu dosyada
    cleartextTrafficPermitted degerini "false" yaparak kapatmaniz onerilir.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
