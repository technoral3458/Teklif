<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Petkit'in Çin bölgesi sunucusu (api.petkit.cn) düz HTTP kullanabiliyor. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">petkit.cn</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
