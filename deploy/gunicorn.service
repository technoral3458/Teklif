[Unit]
Description=Teklif Gunicorn (Django)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/teklif/Teklif/backend
EnvironmentFile=/opt/teklif/Teklif/backend/.env
ExecStart=/opt/teklif/Teklif/backend/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 --workers 3 --timeout 60
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
